# ---------------------------------------------------------------------------
# Demo deployment configuration — TEMPLATE.
#
#   cp .env.demo.example .env.demo
#   # fill every CHANGE_ME, then:  chmod 600 .env.demo
#
# .env.demo is git-ignored. It is loaded by db / api / migrate / seed /
# frontend in compose.demo.yml. Placeholders only in this file — no real
# secret, and never the DB password that was committed to git history.
#
# Generate strong values:
#   SECRET_KEY          python -c "import secrets;print(secrets.token_urlsafe(48))"
#   DB / demo passwords python -c "import secrets;print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------------------

# ---- PostgreSQL container -------------------------------------------------
POSTGRES_USER=inventory_demo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inventory_demo

# ---- FastAPI: database ---------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=inventory_demo
DB_USER=inventory_demo
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://inventory_demo:CHANGE_ME@db:5432/inventory_demo

# ---- FastAPI: production gate ------------------------------------------
# ENV=production turns on the config safety gate. The API refuses to start
# with a weak/placeholder SECRET_KEY, an empty/wildcard/non-https CORS origin.
ENV=production
SECRET_KEY=CHANGE_ME

# Browser talks only to the Next BFF (same-origin), so FastAPI CORS is never
# exercised — but the gate still requires one explicit https origin.
# Replace with the real Tailscale Funnel hostname before deploying, e.g.
#   CORS_ORIGINS=https://<machine>.<tailnet>.ts.net
CORS_ORIGINS=https://CHANGE_ME.demo.example

# Safe defaults are inherited from app/core/config.py — leave unset unless
# you have a reason:
#   ACCESS_TOKEN_EXPIRE_MINUTES=720   DOCS_ENABLED unset -> /docs OFF in prod
#   TRUSTED_PROXY_COUNT=0 (correct with uvicorn --proxy-headers)
#   MAX_UPLOAD_BYTES=5242880          RATE_LIMIT_MAX_REQUESTS=300 / 60s
#   AUTH_RATE_LIMIT_MAX_REQUESTS=5 / 300s   (a demo driver mistyping the
#     password 5x in 5 min locks that account — this is intentional)

# ---- Next.js frontend (server-side runtime only) ----------------------
API_BASE_URL=http://api:8081
NODE_ENV=production
SESSION_COOKIE_NAME=wc_session
COOKIE_SECURE=1

# ---- Pinned images (no :latest) --------------------------------------
# Set from the current commit:  git rev-parse --short HEAD
API_IMAGE=inventory-api:sha-CHANGE_ME
FRONTEND_IMAGE=inventory-frontend:sha-CHANGE_ME

# ---- Demo data seed (scripts/seed_demo.py) --------------------------
# The seed refuses to run without SEED_CONFIRM=1 and refuses production-like
# DB targets. Passwords are read from the environment only.
SEED_CONFIRM=1
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_WH_PASSWORD=CHANGE_ME
