# --- Warehouse Console frontend (Phase 1) ---------------------------------
# Server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix).

# Base URL of the FastAPI backend (Phases 1-9). No trailing slash.
API_BASE_URL=http://localhost:8081

# Name of the HttpOnly session cookie that holds the FastAPI bearer token.
SESSION_COOKIE_NAME=wc_session

# Set to "1" in production so the session cookie is marked Secure.
# Leave unset for local http development.
# COOKIE_SECURE=1
