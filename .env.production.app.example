# Runtime database credentials for the API ONLY (compose.prod.yml loads this
# after .env.production for the api service, so these values win there).
# Copy to .env.production.app, fill every CHANGE_ME, chmod 600.
#
# The role is created by scripts/app_db_role.py provision, run as the migrator
# with the SAME password in APP_DB_PASSWORD. See docs/deployment.md.
# Never use POSTGRES_USER here: that role is a superuser.

DB_USER=inventory_app
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://inventory_app:CHANGE_ME@db:5432/inventory_db
