# Copy to .env.production, fill every CHANGE_ME, chmod 600.
# The application REFUSES TO START in production with a placeholder/weak
# SECRET_KEY, an empty CORS_ORIGINS, a wildcard origin, or a non-https origin.

POSTGRES_USER=inventory
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inventory_db

DB_HOST=db
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=inventory
DB_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+psycopg2://inventory:CHANGE_ME@db:5432/inventory_db

# >= 32 random characters. e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=CHANGE_ME

ENV=production

# 12h default. Override if needed.
ACCESS_TOKEN_EXPIRE_MINUTES=720

APP_NAME=Inventory Management System
APP_VERSION=2.0.0

# Explicit production frontend origin(s), comma-separated, https:// only.
CORS_ORIGINS=https://CHANGE_ME.example.com

# --- optional (safe defaults shown) ---
# DOCS_ENABLED=0                 # set 1 to expose /docs in production
# METRICS_ENABLED=0             # /metrics is always admin-gated regardless
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# TRUSTED_PROXY_COUNT=0         # >0 only if NOT using uvicorn --proxy-headers
# MAX_UPLOAD_BYTES=5242880
# RATE_LIMIT_MAX_REQUESTS=300
# RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_MAX_REQUESTS=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# API image is pinned at deploy time, not here:
#   API_IMAGE=ghcr.io/<owner>/inventory-management-system:v1.0.0
